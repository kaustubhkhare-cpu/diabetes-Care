function closeModal() {
    document.getElementById('productModal').classList.remove('open');
}

let modalQty = 1;
let selectedVariantIndex = 0;

function selectVariant(productId, variantIndex) {
    const product = products.find(p => p.id === productId);
    selectedVariantIndex = variantIndex;
    
    document.querySelectorAll('.modal-variant-option').forEach((el, i) => {
        el.classList.toggle('active', i === variantIndex);
    });
    
    const price = product.variants[variantIndex].price;
    document.querySelector('.modal-product-price').textContent = `₹${price}`;
    document.getElementById('modalTotalPrice').textContent = price * modalQty;
}

function changeModalQty(change) {
    modalQty = Math.max(1, modalQty + change);
    document.getElementById('modalQty').textContent = modalQty;
    
    const productId = parseInt(document.getElementById('productModal').dataset.productId);
    const product = products.find(p => p.id === productId);
    const price = product.variants[selectedVariantIndex].price;
    document.getElementById('modalTotalPrice').textContent = price * modalQty;
}

function addToCartFromModal(productId) {
    for (let i = 0; i < modalQty; i++) {
        addToCart(productId, selectedVariantIndex);
    }
    closeModal();
    modalQty = 1;
    selectedVariantIndex = 0;
}

function proceedToCheckout() {
    if (cart.length === 0) {
        showNotification('Your cart is empty!', 'error');
        return;
