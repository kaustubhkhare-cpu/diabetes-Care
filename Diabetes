    const message = `Hi! I want to order the following items:\n\n${cart.map(item => 
        `${item.name} (${item.variant}) x${item.quantity} - ₹${item.price * item.quantity}`
    ).join('\n')}\n\nTotal: ₹${cart.reduce((sum, item) => sum + (item.price * item.quantity), 0)}`;
    
    window.open(`https://wa.me/919999999999?text=${encodeURIComponent(message)}`);
}

