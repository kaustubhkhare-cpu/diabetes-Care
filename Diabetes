    <meta name="keywords" content="diabetes care india, diabetes management, online diabetes store, diabetic supplements, blood sugar monitor, Dr Morepen products, home healthcare">
    <title>Honest Health - Complete Diabetes Care at Home | Online Store & Care Packages</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
:root {
    --primary-beige: #F5F1E8;
    --secondary-beige: #E8DCC8;
    --accent-gold: #C9A86A;
    --dark-brown: #4A3F35;
    --text-primary: #2C2416;
    --text-secondary: #6B5D4F;
    --white: #FFFFFF;
    --success-green: #5C8E5A;
    --light-gold: #F4ECD8;
    --error-red: #D64545;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    color: var(--text-primary);
    background-color: var(--primary-beige);
    line-height: 1.6;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    line-height: 1.3;
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideInRight {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes slideInLeft {
    from {
        transform: translateX(-100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

@keyframes scaleIn {
    from {
        opacity: 0;
        transform: scale(0.8);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

/* Header */
header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 30px rgba(0,0,0,0.08);
    z-index: 1000;
    transition: all 0.3s ease;
}

nav {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--dark-brown);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.logo-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, var(--accent-gold), var(--dark-brown));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1.3rem;
}

.nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    align-items: center;
}

.nav-links a {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
}

.nav-links a:hover {
    color: var(--accent-gold);
}

.cart-icon {
    position: relative;
    font-size: 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.cart-icon:hover {
    color: var(--accent-gold);
    transform: scale(1.1);
}

.cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--error-red);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 50%;
    min-width: 20px;
    text-align: center;
}

.mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: var(--dark-brown);
}

/* Hero Section */
.hero {
    margin-top: 80px;
    padding: 5rem 2rem;
    background: linear-gradient(135deg, var(--primary-beige) 0%, var(--secondary-beige) 100%);
    min-height: 90vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(201, 168, 106, 0.15) 0%, transparent 70%);
    animation: float 8s ease-in-out infinite;
}

.hero-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
}

.hero-content {
    animation: fadeInUp 1s ease;
}

.hero-content h1 {
    font-size: 4rem;
    color: var(--dark-brown);
    margin-bottom: 1.5rem;
    line-height: 1.1;
}

.hero-highlight {
    color: var(--accent-gold);
}

.hero-tagline {
    font-size: 1.4rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.7;
}

.hero-cta-group {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.primary-cta {
    background: linear-gradient(135deg, var(--dark-brown), #5A4B3D);
    color: var(--white);
    padding: 1.3rem 3rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.4s ease;
    box-shadow: 0 6px 30px rgba(74, 63, 53, 0.4);
    display: inline-block;
}

.primary-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(201, 168, 106, 0.5);
}

.secondary-cta {
    background: transparent;
    color: var(--dark-brown);
    padding: 1.3rem 3rem;
    border: 2px solid var(--dark-brown);
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    display: inline-block;
}

.secondary-cta:hover {
    background: var(--dark-brown);
    color: var(--white);
    transform: translateY(-3px);
}

.hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fadeIn 1.5s ease;
}

.hero-visual {
    width: 100%;
    max-width: 500px;
    height: 500px;
    background: linear-gradient(135deg, var(--light-gold), var(--secondary-beige));
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    animation: float 6s ease-in-out infinite;
}

/* Trust Slider Section */
.trust-slider-section {
    padding: 4rem 2rem;
    background: var(--white);
    overflow: hidden;
}

.trust-slider-container {
    max-width: 1400px;
    margin: 0 auto;
}

.trust-slider {
    display: flex;
    gap: 3rem;
    animation: scroll 30s linear infinite;
    width: fit-content;
}

.trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-width: 250px;
    padding: 2rem;
    background: var(--primary-beige);
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.trust-icon {
    font-size: 3rem;
    color: var(--accent-gold);
}

.trust-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--dark-brown);
    font-family: 'Playfair Display', serif;
}

.trust-label {
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
}

@keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* Why Choose Us Section */
.why-choose-section {
    padding: 6rem 2rem;
    background: linear-gradient(180deg, var(--white) 0%, var(--primary-beige) 100%);
}

.why-choose-container {
    max-width: 1400px;
    margin: 0 auto;
}

.section-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 4rem;
}

.section-subtitle {
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1rem;
}

.section-title {
    font-size: 3.5rem;
    color: var(--dark-brown);
    margin-bottom: 1.5rem;
}

.section-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.8;
}

.why-choose-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
}

.why-choose-card {
    background: var(--white);
    padding: 3rem;
    border-radius: 25px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    transition: all 0.4s ease;
    text-align: center;
    border: 2px solid transparent;
}

.why-choose-card:hover {
    transform: translateY(-15px);
    border-color: var(--accent-gold);
    box-shadow: 0 15px 50px rgba(0,0,0,0.15);
}

.why-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    display: inline-block;
    animation: bounce 2s ease-in-out infinite;
}

.why-choose-card:nth-child(2) .why-icon {
    animation-delay: 0.2s;
}

.why-choose-card:nth-child(3) .why-icon {
    animation-delay: 0.4s;
}

.why-choose-card:nth-child(4) .why-icon {
    animation-delay: 0.6s;
}

.why-title {
    font-size: 1.8rem;
    color: var(--dark-brown);
    margin-bottom: 1rem;
}

.why-description {
    color: var(--text-secondary);
    line-height: 1.7;
}

/* Care Packages Section */
.packages-section {
    padding: 6rem 2rem;
    background: var(--white);
}

.packages-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 3rem;
}

.package-card {
    background: var(--white);
    border-radius: 30px;
    padding: 3rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    transition: all 0.4s ease;
    border: 3px solid transparent;
    position: relative;
    overflow: hidden;
}

.package-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--accent-gold), var(--dark-brown));
    transform: scaleX(0);
    transition: transform 0.4s ease;
}

.package-card:hover::before {
    transform: scaleX(1);
}

.package-card:hover {
    transform: translateY(-15px);
    border-color: var(--accent-gold);
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}

.package-card.featured {
    background: linear-gradient(135deg, var(--dark-brown), #5A4B3D);
    color: white;
    transform: scale(1.05);
}

.popular-badge {
    position: absolute;
    top: 20px;
    right: -35px;
    background: var(--accent-gold);
    color: white;
    padding: 0.5rem 3rem;
    transform: rotate(45deg);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.package-tier {
    display: inline-block;
    background: var(--accent-gold);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
}

.package-name {
    font-size: 2.5rem;
    color: var(--dark-brown);
    margin-bottom: 1rem;
}

.package-card.featured .package-name {
    color: white;
}

.package-price {
    font-size: 4rem;
    font-weight: 700;
    color: var(--dark-brown);
    margin-bottom: 0.5rem;
    font-family: 'Playfair Display', serif;
}

.package-card.featured .package-price {
    color: var(--accent-gold);
}

.package-duration {
    color: var(--text-secondary);
    margin-bottom: 2rem;
}

.package-card.featured .package-duration {
    color: rgba(255,255,255,0.8);
}

.package-features {
    list-style: none;
    margin: 2rem 0;
}

.package-feature {
    padding: 1rem 0;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
}

.package-card.featured .package-feature {
    border-bottom-color: rgba(255,255,255,0.1);
}

.check-icon {
    color: var(--success-green);
    font-size: 1.5rem;
    flex-shrink: 0;
}

.package-card.featured .check-icon {
    color: var(--accent-gold);
}

.subscribe-btn {
    width: 100%;
    padding: 1.5rem;
    background: var(--accent-gold);
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 2rem;
}

.subscribe-btn:hover {
    background: var(--dark-brown);
    transform: scale(1.05);
}

.package-card.featured .subscribe-btn {
    background: var(--accent-gold);
}

.package-card.featured .subscribe-btn:hover {
    background: white;
    color: var(--dark-brown);
}

/* Trust Indicators Section */
.trust-indicators-section {
    padding: 6rem 2rem;
    background: linear-gradient(135deg, var(--dark-brown), #5A4B3D);
    color: white;
}

.trust-indicators-container {
    max-width: 1400px;
    margin: 0 auto;
}

.trust-indicators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
}

.trust-indicator-card {
    text-align: center;
    padding: 2rem;
    background: rgba(255,255,255,0.1);
    border-radius: 20px;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
}

.trust-indicator-card:hover {
    background: rgba(255,255,255,0.15);
    transform: scale(1.05);
}

.trust-indicator-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    color: var(--accent-gold);
}

.trust-indicator-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.trust-indicator-description {
    opacity: 0.9;
    line-height: 1.6;
}

/* Products Section */
.products-section {
    padding: 6rem 2rem;
    background: var(--primary-beige);
}

.product-preview-text {
    text-align: center;
    margin-top: 3rem;
}

.view-all-products-btn {
    display: inline-block;
    padding: 1.2rem 3rem;
    background: var(--accent-gold);
    color: white;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    margin-top: 2rem;
}

.view-all-products-btn:hover {
    background: var(--dark-brown);
    transform: scale(1.05);
}

.products-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2.5rem;
}

.product-card {
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.4s ease;
    border: 2px solid transparent;
    cursor: pointer;
    position: relative;
}

.product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    border-color: var(--accent-gold);
}

.product-image {
    width: 100%;
    height: 250px;
    background: linear-gradient(135deg, var(--light-gold), var(--secondary-beige));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    position: relative;
    overflow: hidden;
}

.product-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: var(--success-green);
    color: white;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.product-info {
    padding: 1.5rem;
}

.product-category {
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.product-name {
    font-size: 1.3rem;
    color: var(--dark-brown);
    margin-bottom: 0.8rem;
    font-weight: 600;
}

.product-description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.product-price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--dark-brown);
    margin-bottom: 1rem;
    font-family: 'Playfair Display', serif;
}

.product-actions {
    display: flex;
    gap: 0.5rem;
}

.add-to-cart-btn {
    flex: 1;
    padding: 1rem;
    background: var(--accent-gold);
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.add-to-cart-btn:hover {
    background: var(--dark-brown);
    transform: scale(1.05);
}

.view-details-btn {
    padding: 1rem 1.5rem;
    background: var(--primary-beige);
    color: var(--dark-brown);
    border: 2px solid var(--accent-gold);
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.view-details-btn:hover {
    background: var(--accent-gold);
    color: white;
}

/* How It Works Section */
.how-it-works-section {
    padding: 6rem 2rem;
    background: var(--white);
}

.how-it-works-container {
    max-width: 1400px;
    margin: 0 auto;
}

.steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
}

.step-card {
    text-align: center;
    padding: 2rem;
    position: relative;
}

.step-number {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--accent-gold), var(--dark-brown));
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 auto 1.5rem;
    font-family: 'Playfair Display', serif;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.step-title {
    font-size: 1.5rem;
    color: var(--dark-brown);
    margin-bottom: 1rem;
}

.step-description {
    color: var(--text-secondary);
    line-height: 1.7;
}

/* FAQ Section */
.faq-section {
    padding: 6rem 2rem;
    background: var(--primary-beige);
}

.faq-container {
    max-width: 900px;
    margin: 0 auto;
}

.faq-item {
    background: var(--white);
    border-radius: 15px;
    margin-bottom: 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
}

.faq-item:hover {
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
}

.faq-question {
    padding: 1.5rem 2rem;
    background: var(--white);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--dark-brown);
    transition: all 0.3s ease;
}

.faq-question:hover {
    color: var(--accent-gold);
}

.faq-icon {
    font-size: 1.5rem;
    transition: transform 0.3s ease;
    color: var(--accent-gold);
}

.faq-item.active .faq-icon {
    transform: rotate(180deg);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: var(--light-gold);
}

.faq-answer-content {
    padding: 1.5rem 2rem;
    color: var(--text-secondary);
    line-height: 1.8;
}

/* CTA Banner Section */
.cta-banner-section {
    padding: 6rem 2rem;
    background: linear-gradient(135deg, var(--accent-gold), var(--dark-brown));
    position: relative;
    overflow: hidden;
}

.cta-banner-section::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    animation: float 10s ease-in-out infinite;
}

.cta-banner-container {
    max-width: 900px;
